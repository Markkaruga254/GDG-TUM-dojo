# =============================================================================
# GDG TUM Build Arena — backend environment variables
# Copy to `.env` and fill in real values. Never commit a filled-in .env.
# All values below are safe placeholders, not secrets.
# =============================================================================

# --- Core -------------------------------------------------------------------
# development | test | production
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=true
# Public base URL of this API (used to build the GitHub OAuth redirect URI).
BACKEND_BASE_URL=http://localhost:8000
# Comma-separated list of frontend origins allowed with credentials.
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:3000
# Optional comma-separated host allow-list (empty = accept any Host header).
ALLOWED_HOSTS=
# Set to true only when running behind a trusted reverse proxy that sets
# X-Forwarded-For (e.g. Render). Otherwise client IPs can be spoofed.
TRUST_PROXY_HEADERS=false

# --- Database ---------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://buildarena:buildarena@localhost:5432/buildarena
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=1800
# Used by docker-compose only:
POSTGRES_USER=buildarena
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=buildarena
POSTGRES_PORT=5432

# --- GitHub OAuth (required for authentication) ------------------------------
# Create an OAuth App at https://github.com/settings/developers
# Authorization callback URL: <BACKEND_BASE_URL>/api/v1/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Minimum scope needed to read the authenticated user's public profile.
GITHUB_OAUTH_SCOPES=read:user
# Optional server-side token used for repository metadata lookups during
# evaluation (raises the 60 req/h anonymous API limit). Never exposed to users.
GITHUB_API_TOKEN=
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_OAUTH_AUTHORIZE_URL=https://github.com/login/oauth/authorize
GITHUB_OAUTH_TOKEN_URL=https://github.com/login/oauth/access_token
GITHUB_API_TIMEOUT_SECONDS=10
# Where the browser is sent after a successful OAuth callback.
FRONTEND_AUTH_REDIRECT_URL=http://localhost:5173/auth/callback

# Bootstrap: comma-separated GitHub usernames that receive the admin role on
# first login. Use `python -m scripts.promote_admin <username>` instead if you
# prefer to promote explicitly.
ADMIN_GITHUB_USERNAMES=

# --- Sessions and cookies ----------------------------------------------------
SESSION_TTL_HOURS=168
# Defaults to true when ENVIRONMENT=production. Keep false for plain-http local dev.
SESSION_COOKIE_SECURE=
# Optional cookie Domain attribute (leave empty for host-only cookies).
COOKIE_DOMAIN=

# --- Abuse limits ------------------------------------------------------------
RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_PER_MINUTE=30
SUBMISSION_RATE_LIMIT_PER_HOUR=30
EVALUATION_RATE_LIMIT_PER_HOUR=60
DEFAULT_RATE_LIMIT_PER_MINUTE=240
SUBMISSION_COOLDOWN_SECONDS=30
MAX_SUBMISSIONS_PER_CHALLENGE_PER_DAY=10
MAX_EVIDENCE_URLS=5
MAX_NOTES_LENGTH=4000
MAX_REPO_URL_LENGTH=300
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# --- Evaluation ---------------------------------------------------------------
EVALUATOR_VERSION=1.0.0
